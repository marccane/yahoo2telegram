# Settings template. Copy it to .env (which git ignores), fill it in, and
# install it as /etc/yahoo2telegram.env (see README.md).

# Yahoo account and the app password generated at
# https://login.yahoo.com/account/security -> "Generate app password"
# (your normal Yahoo password will NOT work over IMAP)
YAHOO_USER=yourname@yahoo.com
YAHOO_APP_PASSWORD=abcdefghijklmnop

# Bot token from @BotFather
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Group to post in. From a message link t.me/c/1234567890/... the chat ID
# is -100 followed by that number.
TG_CHAT_ID=-1001234567890

# Optional: topic to post in, for groups with Topics enabled. From a message
# link t.me/c/1234567890/3/45 the topic ID is 3. Leave unset to post in the
# group itself (in a group with Topics, that is the "General" topic).
#TG_THREAD_ID=3

# Optional
#MAILBOX=INBOX
# Also forward what lands in Yahoo's spam folder ("auto" finds it, "none" turns it off)
#SPAM_FOLDER=auto
#MAX_BODY_CHARS=12000
#FORWARD_ATTACHMENTS=1
# Set to 1 before the very first run to also forward every mail already in the inbox
#BACKFILL=0
